# Doctor password (default: doctor123)
DOCTOR_PASSWORD=doctor123

# Free AI (optional)
GROQ_API_KEY=
OPENAI_API_KEY=

FLASK_SECRET_KEY=change-me-to-a-long-random-string

# Google Calendar (service account JSON as one line + calendar id)
# 1) Create a Google Cloud service account with Calendar API enabled
# 2) Download JSON key and paste the whole JSON into GOOGLE_SERVICE_ACCOUNT_JSON
# 3) Share your Google Calendar with the service account email (Editor)
# 4) Set GOOGLE_CALENDAR_ID (use "primary" for that account, or the calendar ID)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata
